{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",

  "version": 10,

  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "binaryDir": "build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "${presetName}"
      }
    },
    {
      "name": "Debug",
      "inherits": "common"
    },
    {
      "name": "Release",
      "inherits": "common"
    },
    {
      "name": "MinSizeRel",
      "inherits": "common"
    },
    {
      "name": "RelWithDebInfo",
      "inherits": "common"
    },
    {
      "name": "Test",
      "inherits": "RelWithDebInfo",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "Common",
      "hidden": true,
      "jobs": 4
    },
    {
      "name": "Debug",
      "inherits": "Common",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "inherits": "Common",
      "configurePreset": "Release"
    },
    {
      "name": "MinSizeRel",
      "inherits": "Common",
      "configurePreset": "MinSizeRel"
    },
    {
      "name": "RelWithDebInfo",
      "inherits": "Common",
      "configurePreset": "RelWithDebInfo"
    },
    {
      "name": "Test",
      "inherits": "Common",
      "configurePreset": "Test"
    }
  ],

  "testPresets": [
    {
      "name": "Default",
      "displayName": "${presetName}",
      "configurePreset": "Test",
      "execution": {
        "jobs": 4
      }
    }
  ],

  "workflowPresets": [
    {
      "name": "Debug",
      "steps": [
        {
          "type": "configure",
          "name": "Debug"
        },
        {
          "type": "build",
          "name": "Debug"
        }
      ]
    },
    {
      "name": "Release",
      "steps": [
        {
          "type": "configure",
          "name": "Release"
        },
        {
          "type": "build",
          "name": "Release"
        }
      ]
    },
    {
      "name": "MinSizeRel",
      "steps": [
        {
          "type": "configure",
          "name": "MinSizeRel"
        },
        {
          "type": "build",
          "name": "MinSizeRel"
        }
      ]
    },
    {
      "name": "RelWithDebInfo",
      "steps": [
        {
          "type": "configure",
          "name": "RelWithDebInfo"
        },
        {
          "type": "build",
          "name": "RelWithDebInfo"
        }
      ]
    },
    {
      "name": "Test",
      "steps": [
        {
          "type": "configure",
          "name": "Test"
        },
        {
          "type": "build",
          "name": "Test"
        },
        {
          "type": "test",
          "name": "Default"
        }
      ]
    }
  ]
}
